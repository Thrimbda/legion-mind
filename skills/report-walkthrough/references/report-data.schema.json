{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legionmind.local/schemas/standalone-report-data.schema.json",
  "title": "Standalone review walkthrough data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "summary", "status", "evidence"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "summary": { "$ref": "#/$defs/nonEmptyString" },
    "status": { "enum": ["complete", "partial", "blocked", "informational"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "included": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "excluded": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "nextSteps": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kicker": { "$ref": "#/$defs/nonEmptyString" },
        "reviewer": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "safeLocator": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\).+$"
    },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "status"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["pass", "fail", "info", "not-run"] },
        "detail": { "$ref": "#/$defs/nonEmptyString" },
        "locator": { "$ref": "#/$defs/safeLocator" },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "severity": { "enum": ["low", "medium", "high"] },
        "mitigation": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
